{
  "manifest_version": 3,
  "name": "BrowserWatch",
  "version": "1.0.0",
  "description": "Summarize articles and documents into a private local memory.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "extension/background.js"
  },
  "action": {
    "default_title": "BrowserWatch",
    "default_popup": "extension/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "extension/page-analysis.js",
        "extension/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
